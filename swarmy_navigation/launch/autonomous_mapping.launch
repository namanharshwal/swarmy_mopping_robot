<launch>
  <!-- 1. Start core bringup and GMapping -->
  <include file="$(find swarmy_navigation)/launch/mapping.launch">
    <arg name="rviz" value="false"/>
  </include>

  <!-- 2. Start move_base for navigation during mapping -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find swarmy_navigation)/config/move_base_params.yaml" command="load"/>
    <rosparam file="$(find swarmy_navigation)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find swarmy_navigation)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find swarmy_navigation)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find swarmy_navigation)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find swarmy_navigation)/config/base_local_planner_params.yaml" command="load"/>
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
  </node>

  <!-- 3. Start explore_lite for autonomous frontier exploration -->
  <node pkg="explore_lite" type="explore" name="explore" output="screen">
    <param name="robot_base_frame" value="base_footprint"/>
    <param name="costmap_topic" value="map"/>
    <param name="costmap_updates_topic" value="map_updates"/>
    <param name="visualize" value="true"/>
    <param name="planner_frequency" value="0.33"/>
    <param name="progress_timeout" value="30.0"/>
    <param name="potential_scale" value="3.0"/>
    <param name="orientation_scale" value="0.0"/>
    <param name="gain_scale" value="1.0"/>
    <param name="transform_tolerance" value="0.3"/>
    <param name="min_frontier_size" value="0.15"/>
  </node>

  <!-- 4. Bridge RViz 'Publish Point' tool to move_base_simple/goal for manual waypoints -->
  <node pkg="swarmy_teleop" type="publish_point_to_goal.py" name="publish_point_to_goal" output="screen"/>
</launch>
